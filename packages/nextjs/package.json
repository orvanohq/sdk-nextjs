{
  "name": "@orvano/nextjs",
  "version": "0.0.0",
  "description": "The Orvano SDK for Next.js App Router apps: server and browser clients, created per request.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orvanohq/sdk-nextjs.git",
    "directory": "packages/nextjs"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "conformance": "vitest run --project conformance-server --project conformance-client"
  },
  "dependencies": {
    "@orvano/client": "^0.0.0",
    "@orvano/server": "^0.0.0",
    "client-only": "0.0.1",
    "server-only": "0.0.1"
  },
  "peerDependencies": {
    "next": ">=16.0.0 <17"
  },
  "engines": {
    "node": ">=22.12"
  }
}
